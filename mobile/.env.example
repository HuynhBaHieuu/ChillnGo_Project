# Copy to .env, fill in what you have, and run with
#   --dart-define-from-file=.env
# (Android Studio: Run > Edit Configurations > main.dart > Additional run args).
# Every value is optional. .env is git-ignored: never commit real keys.

# The API (server/). Empty: the computer running it on port 4000, reached as
# http://10.0.2.2:4000 from the Android emulator, and as http://localhost:4000
# from a phone on USB after `adb reverse tcp:4000 tcp:4000`.
# A phone on Wi-Fi: http://<the computer's LAN address>:4000
API_URL=

# The website, so links shared from the phone open it (e.g. https://chillngo.vercel.app).
# Empty: shared links open the app instead (chillngo://app/...).
WEB_URL=

# Mapbox public token (pk....), the same as VITE_MAPBOX_TOKEN in web/.env.local.
# Empty: OpenStreetMap tiles, no place search, no road routes.
MAPBOX_TOKEN=

# Google sign-in: the OAuth "Web" client id, the same value as GOOGLE_CLIENT_ID
# in server/.env. An Android OAuth client is needed too (see README.md).
# Empty: no Google button.
GOOGLE_WEB_CLIENT_ID=

# iOS only: the OAuth "iOS" client id.
GOOGLE_IOS_CLIENT_ID=
