# MongoDB Atlas connection string.
# Atlas -> your cluster -> Connect -> Drivers. Put the database name after the
# host, e.g. mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/chillngo?retryWrites=true&w=majority
MONGODB_URI=

# Secret used to sign login tokens. At least 32 random characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# How long a login lasts before the user has to sign in again.
JWT_EXPIRES_IN=7d

# Comma-separated list of web origins allowed to call the API.
# Local dev goes through the Vite proxy, so this only matters once deployed,
# e.g. https://chillngo.vercel.app
CORS_ORIGIN=http://localhost:5173

# Local port. Ignored on Vercel.
PORT=4000

# ── Email (verification links) ──────────────────────────────────────────────
# The web address links in emails open. Required on Vercel.
APP_URL=http://localhost:5173

# SMTP account used to send email. Leave SMTP_USER/SMTP_PASS blank in local
# dev and the verification link is printed in the server terminal instead.
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it as SMTP_PASS.
SMTP_USER=
SMTP_PASS=
# Defaults to Gmail. Change for another provider (e.g. smtp-relay.brevo.com, 587).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# Sender shown in the inbox. Defaults to "ChillnGo <SMTP_USER>".
MAIL_FROM=

# ── Sign in with Google ─────────────────────────────────────────────────────
# OAuth client ID (type "Web application") from Google Cloud Console >
# APIs & Services > Credentials. Put the same value in web/.env.local as
# VITE_GOOGLE_CLIENT_ID. Leave blank to hide the Google button.
GOOGLE_CLIENT_ID=

# ── Super Admin (npm run seed:superadmin) ───────────────────────────────────
# Used only by that script, which creates this account and changes no other.
# Without SUPERADMIN_PASSWORD a random password is generated and printed once.
SUPERADMIN_EMAIL=superadmin@chillngo.vn
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=Super Admin
SUPERADMIN_USERNAME=superadmin

# ── Cloudinary (profile avatars and covers) ─────────────────────────────────
# Dashboard > "API environment variable", looks like
# cloudinary://API_KEY:API_SECRET@CLOUD_NAME. Leave blank and image changes
# are refused; the rest of the profile still saves.
CLOUDINARY_URL=

# ── Livestream (LiveKit) ────────────────────────────────────────────────────
# From a LiveKit Cloud project (https://cloud.livekit.io > Settings > Keys),
# or a self-hosted LiveKit server. LIVEKIT_URL is the wss:// address.
# For local testing, `livekit-server --dev` uses ws://127.0.0.1:7880,
# key "devkey", secret "secret". Leave blank to disable livestreams.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional: a PRIVATE S3-compatible bucket for livestream recordings
# (Backblaze B2 needs no credit card; Cloudflare R2 and AWS S3 work too).
# B2: endpoint https://s3.<region>.backblazeb2.com, region e.g. us-east-005.
# R2: endpoint https://<account-id>.r2.cloudflarestorage.com, region auto.
# Leave blank to not offer recording. See README > Livestream.
RECORDING_S3_BUCKET=
RECORDING_S3_ACCESS_KEY=
RECORDING_S3_SECRET=
RECORDING_S3_ENDPOINT=
RECORDING_S3_REGION=

# ── AI models (travel assistant and AI clone) ───────────────────────────────
# Both ask Muse first, then LiveKit Inference, then Gemini: when one fails or
# runs out of tokens, the next is asked. Leave a model's settings blank to skip it.

# Muse: any OpenAI-style API. URL is its base (…/v1) or full …/chat/completions.
# All three are needed, or Muse is skipped.
MUSE_API_KEY=
MUSE_API_URL=
MUSE_MODEL=

# LiveKit Inference uses the LIVEKIT_* keys above, so there is no extra key.
# Needs a LiveKit Cloud project (a self-hosted LiveKit has no inference).
# Model as "provider/model", e.g. openai/gpt-4.1-mini. Default google/gemini-2.5-flash.
ASSISTANT_MODEL=
# 1 to log each database lookup the assistant makes (tool, arguments, result size).
ASSISTANT_DEBUG=

# Google Gemini, asked last (key from https://aistudio.google.com/apikey).
GEMINI_API_KEY=
# Default gemini-3.8-flash.
GEMINI_MODEL=
# AI requests (an AI clone, a chat message) each user may make per day. Default 20.
AI_DAILY_LIMIT_PER_USER=20
