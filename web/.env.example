# Mapbox GL JS public token. Without it, <MapPreview /> renders a static
# fallback panel instead of an interactive map — the app still works.
# Get one at https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=

# OAuth client ID for "Sign in with Google" (same value as GOOGLE_CLIENT_ID in
# server/.env). Leave blank to hide the Google button.
VITE_GOOGLE_CLIENT_ID=

# URL of the deployed API (server/), e.g. https://chillngo-api.vercel.app
# Leave blank for local dev: the Vite dev server proxies /api to localhost:4000.
VITE_API_URL=

# Optional: travel footage for the landing hero when reduced motion is on
# (otherwise the hero uses the interactive neon tubes).
VITE_HERO_VIDEO_URL=
